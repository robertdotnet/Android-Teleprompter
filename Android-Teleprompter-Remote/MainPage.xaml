<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Android_Teleprompter_Remote.MainPage"
             BackgroundColor="#1E1E2E">

    <Grid RowDefinitions="Auto,*,*,*,Auto"
          Padding="12"
          RowSpacing="8"
          BackgroundColor="#1E1E2E">

        <Border Grid.Row="0"
                BackgroundColor="#1E1E2E"
                StrokeThickness="0"
                Padding="8,10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="TELEPROMPT REMOTE"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="● Status"
                       TextColor="#F08080"
                       FontSize="16"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsConnected}"
                                     Value="True">
                            <Setter Property="TextColor" Value="#4CAF50" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Border>

        <Button Grid.Row="1"
                Text="↑  SCROLL UP  ↑"
                Command="{Binding ScrollUpCommand}"
                BackgroundColor="#3A3A4A"
                TextColor="White"
                FontSize="24"
                CornerRadius="12"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Margin="0" />

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="▶ Play/Pause"
                    Command="{Binding PlayPauseCommand}"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontSize="24"
                    CornerRadius="12"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            <Button Grid.Column="1"
                    Text="↺ Restart"
                    Command="{Binding RestartCommand}"
                    BackgroundColor="#3A3A4A"
                    TextColor="White"
                    FontSize="24"
                    CornerRadius="12"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
        </Grid>

        <Button Grid.Row="3"
                Text="↓  SCROLL DOWN ↓"
                Command="{Binding ScrollDownCommand}"
                BackgroundColor="#3A3A4A"
                TextColor="White"
                FontSize="24"
                CornerRadius="12"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Margin="0" />

        <VerticalStackLayout Grid.Row="4"
                             Padding="4,8,4,4"
                             Spacing="2">
            <Label Text="{Binding ScrollSpeed, StringFormat='Speed: {0:F0} dp/s'}"
                   TextColor="White"
                   FontSize="18"
                   HorizontalOptions="Center" />
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="10"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Slider Grid.Column="1"
                        Minimum="10"
                        Maximum="200"
                        Value="{Binding ScrollSpeed, Mode=TwoWay}"
                        MinimumTrackColor="#4CAF50"
                        MaximumTrackColor="#77778A"
                        ThumbColor="#4CAF50"
                        ValueChanged="OnSpeedChanged" />
                <Label Grid.Column="2"
                       Text="200"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
